<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom tab bar of the Scarlet theme: very dark red with a thin line on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF3A1A1D" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF170C0D" />
        </shape>
    </item>
</layer-list>
