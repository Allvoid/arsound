<?xml version="1.0" encoding="utf-8"?>
<!-- Home background: the theme's background with a soft glow of its accent at the top left.
     The glow fades out above the list, which SoundCloud paints with its own background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?themeColorSurface" />
        </shape>
    </item>
    <item android:height="220dp" android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.3"
                android:centerY="0.25"
                android:gradientRadius="150dp"
                android:startColor="${accent@45}"
                android:endColor="${accent@0}" />
        </shape>
    </item>
</layer-list>
