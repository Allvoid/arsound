<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom tab bar: the theme's tab bar colour with a thin line of its border colour on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="${border}" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="${tabbar}" />
        </shape>
    </item>
</layer-list>
