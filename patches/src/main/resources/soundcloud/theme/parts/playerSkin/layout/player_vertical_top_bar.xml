<?xml version="1.0" encoding="utf-8"?>
<!-- arsound:one-look: the player is dark in every mode, so this file keeps the dark colours. -->
<!-- New player (beta): the round buttons at the top right, light icons on dark glass (player_buttons_background_circular). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/player_expanded_top_bar" android:background="@null" android:paddingTop="@dimen/outer_icon_padding" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:paddingHorizontal="@dimen/outer_icon_padding">
    <ImageButton android:id="@id/player_close_indicator" android:contentDescription="@string/accessibility_close" android:nextFocusForward="@id/player_toggle_btn_follow" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:srcCompat="@drawable/ic_actions_chevron_down" app:tint="#FFFFFFFF" style="@style/PlayerTopActionIcon" />
    <ImageButton android:id="@id/player_toggle_btn_follow" android:layout_marginTop="@dimen/top_margin_icon" android:nextFocusForward="@id/track_page_like" android:layoutDirection="locale" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/player_close_indicator" app:tint="#FFFFFFFF" style="@style/PlayerTopActionIcon" />
    <ImageButton android:id="@id/player_qr_session" android:layout_marginTop="@dimen/top_margin_icon" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/player_toggle_btn_follow" app:srcCompat="@drawable/ic_options_share_qr_code" app:tint="#FFFFFFFF" style="@style/PlayerTopActionIcon" />
