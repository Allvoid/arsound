<?xml version="1.0" encoding="utf-8"?>
<!-- arsound:one-look: the player is dark in every mode, so this file keeps the dark colours. -->
<!-- New player: the round buttons at the top right are dark glass with a thin edge instead of white circles. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="${accent@30}">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:left="@dimen/inner_icon_padding" android:top="@dimen/inner_icon_padding"
        android:right="@dimen/inner_icon_padding" android:bottom="@dimen/inner_icon_padding">
        <shape android:shape="oval">
            <solid android:color="${surface@70}" />
            <stroke android:width="1dp" android:color="${miniBorder}" />
        </shape>
    </item>
</ripple>
